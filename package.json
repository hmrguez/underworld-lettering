{
  "name": "underworld-letterpress",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite --host 127.0.0.1",
    "build": "bun --bun vite build",
    "check": "bun run format:check && bun run typecheck && bun run lint",
    "test": "bun test",
    "typecheck": "bun --bun svelte-check --tsconfig ./tsconfig.json --tsgo && bun node_modules/@typescript/native/bin/tsc --noEmit",
    "format": "bun --bun prettier --write .",
    "format:check": "bun --bun prettier --check .",
    "lint": "bun --bun eslint . --max-warnings 0"
  },
  "dependencies": {
    "svelte": "^5.0.0",
    "opentype.js": "^1.3.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/bun": "^1.4.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.0.0"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  }
}
