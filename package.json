    "vite": "^7.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "6.0.3",
    "@types/bun": "^1.4.2",
    "@typescript/native": "npm:typescript@7.0.2"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  }
}
