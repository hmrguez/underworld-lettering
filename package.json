{
  "name": "underworld-letterpress",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite --host 127.0.0.1",
    "build": "bun --bun vite build",
    "check": "bun --bun svelte-check --tsconfig ./tsconfig.json --tsgo && bun node_modules/@typescript/native/bin/tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "svelte": "^5.0.0",
    "opentype.js": "^1.3.4"
  },
  "devDependencies": {
